# Maglev vacuum tunnel: end-game bored vacuum gallery, from 2165
# Portals generated by tools/blender/build_maglev_tunnel.py (--class 4000),
# packed by tools/assemble_sheet.py --sheet tunnel. Front is the headwall
# with the bore left transparent (drawn over a pod, which slides in and is
# swallowed); back is the dark bore interior behind it.

obj=tunnel
name=Maglev_Tunnel_4000
copyright=Aleksander Kwiatkowski
waytype=maglev_track
topspeed=4000
cost=80000000
maintenance=52000
intro_year=2165
intro_month=1
icon=images/maglev_tunnel4000.0.4
cursor=images/maglev_tunnel4000.1.4,0,-16
#SUMMER
FrontImage[N][0]=images/maglev_tunnel4000.0.0
FrontImage[W][0]=images/maglev_tunnel4000.0.1
FrontImage[S][0]=images/maglev_tunnel4000.0.2
FrontImage[E][0]=images/maglev_tunnel4000.0.3
BackImage[N][0]=images/maglev_tunnel4000.1.0
BackImage[W][0]=images/maglev_tunnel4000.1.1
BackImage[S][0]=images/maglev_tunnel4000.1.2
BackImage[E][0]=images/maglev_tunnel4000.1.3
#WINTER
FrontImage[N][1]=images/maglev_tunnel4000.2.0
FrontImage[W][1]=images/maglev_tunnel4000.2.1
