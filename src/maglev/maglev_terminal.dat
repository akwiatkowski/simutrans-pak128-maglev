obj=building
name=Prototype_Maglev_Terminal
copyright=Aleksander Kwiatkowski
type=stop
waytype=maglev_track
enables_pax=1
enables_post=1
Dims=1,1,2
NoInfo=1
# The vacuum century's interchange, above the concourse's
# 15 — sized for 300-passenger capsules on 3000-tile trunks.
Level=22
# Explicit capacity: the engine default (level*32) undersizes
# waiting rooms against this roster's 200-380 seat trains; sized to
# hold about 1.5 full era-matching trainloads.
capacity=1150
allow_underground=0
# 2100: the 2000 km/h tube's year; the terminal wears its
# deeper glass.
intro_year=2100
intro_month=1
retire_year=2999
icon=> images/maglev_terminal.1.4
cursor=images/maglev_terminal.1.5
BackImage[0][0][0][0][0][0]=images/maglev_terminal.1.0
BackImage[1][0][0][0][0][0]=images/maglev_terminal.1.1
FrontImage[0][0][0][0][0][0]=images/maglev_terminal.1.2
FrontImage[1][0][0][0][0][0]=images/maglev_terminal.1.3
