# Maglev tube tunnel: collar portal socketing the glazed tube, from 2080
# Portals generated by tools/blender/build_maglev_tunnel.py (--class 1000),
# packed by tools/assemble_sheet.py --sheet tunnel. Front is the headwall
# with the bore left transparent (drawn over a pod, which slides in and is
# swallowed); back is the dark bore interior behind it.

obj=tunnel
name=Maglev_Tunnel_1000
copyright=Aleksander Kwiatkowski
waytype=maglev_track
topspeed=1000
cost=45000000
maintenance=30000
intro_year=2080
intro_month=1
icon=images/maglev_tunnel1000.0.4
cursor=images/maglev_tunnel1000.1.4,0,-16
#SUMMER
FrontImage[N][0]=images/maglev_tunnel1000.0.0
FrontImage[W][0]=images/maglev_tunnel1000.0.1
FrontImage[S][0]=images/maglev_tunnel1000.0.2
FrontImage[E][0]=images/maglev_tunnel1000.0.3
BackImage[N][0]=images/maglev_tunnel1000.1.0
BackImage[W][0]=images/maglev_tunnel1000.1.1
BackImage[S][0]=images/maglev_tunnel1000.1.2
BackImage[E][0]=images/maglev_tunnel1000.1.3
#WINTER
FrontImage[N][1]=images/maglev_tunnel1000.2.0
FrontImage[W][1]=images/maglev_tunnel1000.2.1
FrontImage[S][1]=images/maglev_tunnel1000.2.2
FrontImage[E][1]=images/maglev_tunnel1000.2.3
BackImage[N][1]=images/maglev_tunnel1000.3.0
BackImage[W][1]=images/maglev_tunnel1000.3.1
BackImage[S][1]=images/maglev_tunnel1000.3.2
BackImage[E][1]=images/maglev_tunnel1000.3.3
