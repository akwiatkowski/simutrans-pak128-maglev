# Maglev signals: block and choose, both from the first guideway year.
#
# Sprites are generated by tools/blender/build_maglev_signal.py and packed by
# tools/assemble_sheet.py --sheet signal: rows 1-2 are block/choose, columns
# 0-3 the red aspect (n,e,s,w), 4-7 the green. Lamp pixels are the reserved
# lights #FF211D / #01DD01, so an aspect stays lit when the map dims.
# State 0 = red/closed, state 1 = green/clear (pak128's convention).

obj=roadsign
name=Maglev_Signal_Block
copyright=Aleksander Kwiatkowski
waytype=maglev_track
is_signal=1
cost=25000
maintenance=800
intro_year=2000
intro_month=1
Image[n][0]=images/maglev_signal.1.0
Image[e][0]=images/maglev_signal.1.1
Image[s][0]=images/maglev_signal.1.2
Image[w][0]=images/maglev_signal.1.3
Image[n][1]=images/maglev_signal.1.4
Image[e][1]=images/maglev_signal.1.5
Image[s][1]=images/maglev_signal.1.6
Image[w][1]=images/maglev_signal.1.7
Icon=images/maglev_signal.1.8
cursor=images/maglev_signal.1.9

---------------------------------------------------------------------------

# The choose signal routes a pod to any free platform behind it — with the
# roster's 5-6 tile trains and multi-platform termini this is what keeps a
# trunk's throughput up. Twin heads, the classic route-indicator silhouette.

obj=roadsign
name=Maglev_Signal_Choose
copyright=Aleksander Kwiatkowski
waytype=maglev_track
is_signal=1
free_route=1
cost=45000
maintenance=1400
intro_year=2000
intro_month=1
Image[n][0]=images/maglev_signal.2.0
Image[e][0]=images/maglev_signal.2.1
Image[s][0]=images/maglev_signal.2.2
Image[w][0]=images/maglev_signal.2.3
Image[n][1]=images/maglev_signal.2.4
Image[e][1]=images/maglev_signal.2.5
Image[s][1]=images/maglev_signal.2.6
Image[w][1]=images/maglev_signal.2.7
Icon=images/maglev_signal.2.8
cursor=images/maglev_signal.1.9
