#TUBE
obj=way
name=Prototype_Maglev_Tube_1000
copyright=Olek
waytype=maglev_track
draw_as_ding=1
# Enclosed glazed guideway. The back images carry the apron, the beam and
# the far half of the tube; the front images carry the near half, which
# Simutrans draws after vehicles, so a pod is seen through the glass.
cost=940000
maintenance=13500
topspeed=1000
max_weight=80
intro_year=2080
intro_month=1
retire_year=2999
retire_month=1
icon=> maglev_tube.0.6
cursor=maglev_tube.0.7,0,-16
