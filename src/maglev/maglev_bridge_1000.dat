# Maglev tube crossing: the glazed tube carried on pylons, from 2080
# Sprites generated by tools/blender/build_maglev_bridge.py (--class 1000),
# packed by tools/assemble_sheet.py --sheet bridge. Sprite content sits in
# way-tile coordinates with the deck one height level up, so image offsets
# are zero throughout.

obj=bridge
name=Maglev_Bridge_1000
copyright=Aleksander Kwiatkowski
waytype=maglev_track
topspeed=1000
cost=30000000
maintenance=22000
max_length=32
pillar_distance=2
intro_year=2080
intro_month=1
icon=images/maglev_bridge1000.0.6
cursor=images/maglev_bridge1000.0.7,0,-16
