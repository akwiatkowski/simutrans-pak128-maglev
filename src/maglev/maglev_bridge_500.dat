# Maglev viaduct: the open precast viaduct of the 500 tier, from 2014
# Sprites generated by tools/blender/build_maglev_bridge.py (--class 500),
# packed by tools/assemble_sheet.py --sheet bridge. Sprite content sits in
# way-tile coordinates with the deck one height level up, so image offsets
# are zero throughout.

obj=bridge
name=Maglev_Bridge_500
copyright=Aleksander Kwiatkowski
waytype=maglev_track
topspeed=500
cost=12000000
maintenance=9000
max_length=32
pillar_distance=2
intro_year=2014
intro_month=1
icon=images/maglev_bridge500.0.6
cursor=images/maglev_bridge500.0.7,0,-16
